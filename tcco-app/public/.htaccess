Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QL]

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"

# Cache hashed static assets for 1 year
<FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff2|woff|ico|webp)$">
  Header set Cache-Control "max-age=31536000, immutable"
</FilesMatch>

# Don't cache HTML (always fetch fresh for app shell updates)
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
